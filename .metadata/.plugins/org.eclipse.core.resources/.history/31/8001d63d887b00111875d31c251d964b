package programs;

public class SandleClock {

	public static void main(String[] args) {
		int n=3;
	    for(int i=1;i<=(n/2);i++){
	        for(int s=0;s<=i;s++){
	            System.out.print(" ");
	        }
	        for(int j=i;j<(n-(i*2));j++){
	            System.out.print(j+1+" ");
	        }
	        System.out.println();
	    }

	}

}
