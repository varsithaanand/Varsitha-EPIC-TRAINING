package model;

public class CustomerModel {
	 int cusid;
	 String name;
	 int age;
	 public CustomerModel(int cusid, String name, int age) {
		
		this.cusid = cusid;
		this.name = name;
		this.age = age;
	 }
	 public int getCusid() {
		 return cusid;
	 }
	 public void setCusid(int cusid) {
		 this.cusid = cusid;
	 }
	 public String getName() {
		 return name;
	 }
	 public void setName(String name) {
		 this.name = name;
	 }
	 public int getAge() {
		 return age;
	 }
	 public void setAge(int age) {
		 this.age = age;
	 }
	 
}
